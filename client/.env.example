# Copy this file to .env.local and fill in the real values from the
# Switchboard Supabase project (Project Settings → API Keys).
#
# Use the PUBLISHABLE key here (sb_publishable_...), not the secret key
# (sb_secret_...) -- Vite bakes every VITE_-prefixed var into the shipped
# browser bundle, so only a client-safe key belongs here. The secret key is
# server-only and has no use in this client-only app yet.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave unset (or anything other than "true") until Microsoft sign-in
# actually works end-to-end -- i.e. until the Supabase project's Azure
# provider is enabled under Authentication → Providers, backed by an Azure
# App Registration restricted to "Accounts in this organizational directory
# only" (@kidzink.com tenant). Until then the app runs in demo mode: every
# app shown, no login gate, since a login that can't succeed is worse than
# no login at all. Flip to "true" once Azure sign-in is really usable.
VITE_REQUIRE_LOGIN=
