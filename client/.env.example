# Copy this file to .env.local and fill in the real values from the
# Switchboard Supabase project (Project Settings → API).
#
# Supabase project also needs the Azure (Microsoft) provider enabled under
# Authentication → Providers, backed by an Azure App Registration restricted
# to "Accounts in this organizational directory only" (@kidzink.com tenant).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
